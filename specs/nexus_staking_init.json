{
  "version": "1.0",
  "program": "nexus_staking",
  "program_id": "NexaStaking111111111111111111111111111111111",
  "state_structs": [
    {
      "name": "StakePool",
      "fields": [
        "authority: Pubkey",
        "bump: u8",
        "total_staked: u64"
      ]
    }
  ],
  "contexts": {
    "InitializePool": {
      "accounts": [
        {
          "name": "pool",
          "type": "StakePool",
          "init": true,
          "payer": "signer",
          "space": 49,
          "seeds": ["b\"pool\"", "signer.key().as_ref()"]
        }
      ]
    },
    "Stake": {
      "accounts": [
        {
          "name": "pool",
          "type": "StakePool",
          "init": false,
          "payer": null,
          "space": null,
          "seeds": []
        }
      ]
    }
  },
  "instructions": [
    {
      "name": "initialize_pool",
      "accounts_struct": "InitializePool",
      "logic": "msg!(\"Staking pool initialized\");"
    },
    {
      "name": "stake",
      "accounts_struct": "Stake",
      "logic": "let pool = &mut ctx.accounts.pool;\npool.total_staked = pool.total_staked.checked_add(amount).ok_or(anchor_lang::error::ErrorCode::AccountDidNotSerialize)?;\nmsg!(\"Staked amount: {}\", amount);"
    }
  ]
}
