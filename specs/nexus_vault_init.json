{
  "version": "1.0",
  "program": "nexus_vault",
  "program_id": "NexaVault1111111111111111111111111111111111",
  "state_structs": [
    {
      "name": "Vault",
      "fields": [
        "authority: Pubkey",
        "bump: u8",
        "total_deposits: u64"
      ]
    }
  ],
  "contexts": {
    "InitializeVault": {
      "accounts": [
        {
          "name": "vault",
          "type": "Vault",
          "init": true,
          "payer": "signer",
          "space": 49,
          "seeds": ["b\"vault\"", "signer.key().as_ref()"]
        }
      ]
    },
    "DepositVault": {
      "accounts": [
        {
          "name": "vault",
          "type": "Vault",
          "init": false
        }
      ]
    }
  },
  "instructions": [
    {
      "name": "initialize",
      "accounts_struct": "InitializeVault",
      "logic": "msg!(\"Initializing Vault PDA with seeds\");"
    },
    {
      "name": "deposit",
      "accounts_struct": "DepositVault",
      "logic": "msg!(\"Processing deposit lamports to PDA\");"
    }
  ]
}

